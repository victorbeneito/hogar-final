[mysqld]
# Disable io_uring — causes segfaults in WSL2 with external USB drives
innodb_use_native_aio=0

# Reduce fsync aggressiveness (dev mode: flush every second, not every commit)
innodb_flush_log_at_trx_commit=2

# Flush method compatible with WSL2 bind mounts
innodb_flush_method=O_DSYNC

# Don't sync binary log on every commit
sync_binlog=0

# Avoid DNS lookups on connect
skip_name_resolve=1
