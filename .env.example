SECRETO_JWT=
SECRETO_JWT_CLIENTE =
SECRETO_JWT_ADMIN =

PORT=3000
# URL base del sitio: SIN www y SIN barra final.
# En producción las dos valen https://elhogardetusuenos.com (así están en Plesk).
# APP_URL se lee al arrancar; NEXT_PUBLIC_BASE_URL se incrusta en el build, así que
# cambiarla exige redesplegar, no basta con reiniciar Node.
# Si faltan las dos, src/lib/urls.ts cae en el dominio canónico (o en localhost en dev).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

DATABASE_URL=""

# Google OAuth (Configurar en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REDSYS_SECRET_KEY=secret_key
REDSYS_MERCHANT_CODE=codigo_comercio
REDSYS_TERMINAL=1
REDSYS_ENV= sandbox/real

NEXT_PUBLIC_PAYPAL_CLIENT_ID=client_id
PAYPAL_CLIENT_ID=client_id
PAYPAL_CLIENT_SECRET=client_secret
PAYPAL_MODE=sandbox/production

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Modo de envío: smtp (recomendado para hosting propio)
EMAIL_TRANSPORT_MODE=smtp

# Datos del servidor SMTP de tu hosting (OVH, Arsys, cPanel, etc.)
SMTP_HOST=mail.elhogardetusuenos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@elhogardetusuenos.com
SMTP_PASSWORD=tu_contraseña_aqui
# Ponlo en false si tu hosting usa certificado autofirmado
SMTP_REJECT_UNAUTHORIZED=true

# Remitente que verá el cliente
EMAIL_SENDER_NAME=El Hogar de tus Sueños
EMAIL_SENDER_EMAIL=info@elhogardetusuenos.com
EMAIL_REPLY_TO=info@elhogardetusuenos.com
EMAIL_SUPPORT_EMAIL=info@elhogardetusuenos.com

# (La URL base de la tienda, que también usan los enlaces de los correos,
#  está definida arriba junto a NEXT_PUBLIC_BASE_URL. Antes se repetía aquí
#  con www y machacaba a la de arriba.)

